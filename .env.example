# Copy to .env and fill in. Never commit .env.

# --- Portal infrastructure ---
POSTGRES_USER=portal
POSTGRES_PASSWORD=change_me
POSTGRES_DB=llm_portal
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE_MINUTES=720

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

SYNC_INTERVAL_MINUTES=5
AZURE_SYNC_INTERVAL_MINUTES=30
SYNC_LOOKBACK_HOURS=168

# Optional: pin USD/INR instead of fetching a live rate
# USD_INR_RATE=

# --- NewAPI O1 (optional) ---
NEW_API_BASE_URL=
NEW_API_SYSTEM_TOKEN=
NEW_API_USER_ID=1
# 500000 quota = 1 USD (new-api default QuotaPerUnit)
NEW_API_QUOTA_PER_UNIT=500000

# --- NewAPI O2 (optional) ---
NEW_API2_BASE_URL=
NEW_API2_SYSTEM_TOKEN=
NEW_API2_USER_ID=1
NEW_API2_TAG_FILTER=
# HTTP proxy if the host cannot reach O2 directly
# NEW_API2_PROXY=

# --- Telegram bot (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated Telegram user ids allowed to run bot commands
TELEGRAM_ADMIN_IDS=

# --- Redis (Deploy K3 Azure inventory cache) ---
REDIS_URL=redis://redis:6379/0
# Seconds to keep Foundry/credits lookups. NewAPI is never cached.
KIMI_AZURE_CACHE_TTL_SECONDS=900

# Join wizard: how long an in-progress Azure device-code session stays alive (seconds).
SUBMIT_SESSION_TTL_SECONDS=1800

# --- Shaurya inventory Google Sheet (optional) ---
# Sheet1 tab: Sno | (person) | Email | Endpoint | Api Key | TPM | Proxy_Name | Pool | ...
# Share the sheet (tab Sheet1) with the service account as Editor. Never commit the JSON key.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB=Sheet1
GOOGLE_SHEETS_CREDENTIALS_PATH=/run/secrets/google-sheets.json
# Alternative to a file: paste the service-account JSON as one line.
# GOOGLE_SHEETS_CREDENTIALS_JSON=
PROD_SSH_HOST=
PROD_SSH_USER=
PROD_SSH_PASSWORD=
PROD_WSL_PROJECT=
