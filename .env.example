# Copy to .env and fill in. Never commit .env.

# --- Portal infrastructure ---
POSTGRES_USER=portal
POSTGRES_PASSWORD=change_me
POSTGRES_DB=llm_portal
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE_MINUTES=720

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

SYNC_INTERVAL_MINUTES=5
AZURE_SYNC_INTERVAL_MINUTES=30
SYNC_LOOKBACK_HOURS=168

# Optional: pin USD/INR instead of fetching a live rate
# USD_INR_RATE=

VITE_API_BASE_URL=http://localhost:8000

# --- NewAPI O1 (optional) ---
NEW_API_BASE_URL=
NEW_API_SYSTEM_TOKEN=
NEW_API_USER_ID=1
# 500000 quota = 1 USD (new-api default QuotaPerUnit)
NEW_API_QUOTA_PER_UNIT=500000

# --- NewAPI O2 (optional) ---
NEW_API2_BASE_URL=
NEW_API2_SYSTEM_TOKEN=
NEW_API2_USER_ID=1
NEW_API2_TAG_FILTER=
# HTTP proxy if the host cannot reach O2 directly
# NEW_API2_PROXY=

# --- Telegram bot (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated Telegram user ids allowed to run bot commands
TELEGRAM_ADMIN_IDS=
